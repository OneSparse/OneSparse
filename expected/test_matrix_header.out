│ contains │
├──────────┤
│ t        │
└──────────┘
(1 row)

-- Check multiple positions
select i, j, contains('int32(5:5)[0:0:1 2:2:3 4:4:5]'::matrix, i, j) as present
from generate_series(0, 4) as i, generate_series(0, 4) as j
where i = j;
