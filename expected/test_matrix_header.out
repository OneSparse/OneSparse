-- ## Element Manipulation
--
-- Operations for checking and removing individual elements.
-- Check if matrix contains element at position
select contains('int32(5:5)[0:0:1 2:2:3 4:4:5]'::matrix, 0, 0);
┌──────────┐
│ contains │
├──────────┤
│ t        │
└──────────┘
