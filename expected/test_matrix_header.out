create temporary table mat_agg_float (row_idx bigint, col_idx bigint, val double precision);
insert into mat_agg_float values (0, 0, 1.5), (1, 1, 2.5), (2, 2, 3.5);
select matrix_agg(row_idx, col_idx, val) from mat_agg_float;
