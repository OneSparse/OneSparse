-- Here are some sparse test vectors, they will be used for some of
-- the examples below:
--
select print(u) as u, print(v) as v from test_fixture;
┌───────────┬───────────┐
│     u     │     v     │
├───────────┼───────────┤
│          ↵│          ↵│
│    ───   ↵│    ───   ↵│
│  0│      ↵│  0│      ↵│
│  1│  2   ↵│  1│  3   ↵│
│  2│      ↵│  2│  3   ↵│
│  3│      ↵│  3│      ↵│
│           │           │
└───────────┴───────────┘
(1 row)

select draw(u) as twocol_a_source, draw(v) as twocol_b_source from test_fixture \gset
\i sql/twocol.sql
