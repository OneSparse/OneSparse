├──────────────────┤
│        0   1    ↵│
│     ────────    ↵│
│   0│  20        ↵│
│   1│      40    ↵│
│                  │
└──────────────────┘
(1 row)

-- Extract with indices array
select print(extract_matrix('int32(5:5)[0:0:1 1:1:2 2:2:3 3:3:4 4:4:5]'::matrix, array[0,2,4]::bigint[], array[0,2,4]::bigint[]));
┌──────────────────────┐
│        print         │
├──────────────────────┤
