-- Edge case: operations with zero
select (0::smallint)::scalar + 1::smallint;
 ?column? 
----------
 int16:1
(1 row)

select (1::smallint)::scalar - 0::smallint;
 ?column? 
----------
 int16:1
(1 row)

select (0::smallint)::scalar * 1::smallint;
 ?column? 
----------
 int16:0
(1 row)

select (1::smallint)::scalar * 0::smallint;
 ?column? 
----------
 int16:0
(1 row)

-- Edge case: operations at boundaries
select (1::smallint)::scalar + 0::smallint;
 ?column? 
----------
 int16:1
(1 row)

select (-1::smallint)::scalar - 0::smallint;
 ?column? 
----------
 int16:-1
(1 row)

select (1::smallint)::scalar / 1::smallint;
 ?column? 
----------
