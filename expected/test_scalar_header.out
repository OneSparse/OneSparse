│ ?column? │
├──────────┤
│ int32:3  │
└──────────┘
(1 row)

select 'int32:7'::scalar / 3;
┌──────────┐
│ ?column? │
├──────────┤
│ int32:2  │
└──────────┘
(1 row)

select 'int32:-7'::scalar / 2;
