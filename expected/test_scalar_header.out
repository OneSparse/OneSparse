-- Conditional element update based on scalar threshold
select set_element(
    'int32[0:10 1:20 2:30]'::vector,
    1,
    CASE WHEN (get_element('int32[0:10 1:20 2:30]'::vector, 1)::int) > 15
         THEN 100
         ELSE (get_element('int32[0:10 1:20 2:30]'::vector, 1)::int)
    END
);
