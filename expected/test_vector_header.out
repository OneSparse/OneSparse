-- Assign with full mask
select assign('int32(10)[0:1 1:2 2:3]'::vector,
    'int32(5)[0:10 1:20 2:30 3:40 4:50]'::vector,
    array[0,1,2,3,4]::bigint[],
    mask=>'int32(10)[0:1 1:1 2:1 3:1 4:1]'::vector);
┌─────────────────────────────────────┐
│               assign                │
├─────────────────────────────────────┤
│ int32(10)[0:10 1:20 2:30 3:40 4:50] │
