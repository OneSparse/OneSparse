-- ## Masking with eunion() (Element-wise Union)
--
-- eunion uses default values for missing elements.
-- Element-wise union with mask
select eunion('int32(5)[0:10 2:30]'::vector,
    0::int,
    'int32(5)[1:20 3:40]'::vector,
    0::int,
    'plus_int32'::binaryop,
