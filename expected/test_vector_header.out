-- Assign scalar with mask
select assign('int32(10)[0:1 2:3 4:5]'::vector,
    99::int,
    array[0,2,4,6,8]::bigint[],
    mask=>'int32(10)[0:1 4:1 6:1]'::vector);
┌───────────────────────────────┐
