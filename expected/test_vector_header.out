├────────────────────────────────────────────┤
│ fp64(3)[0:3.000000 1:Infinity 2:-Infinity] │
└────────────────────────────────────────────┘
(1 row)

-- Infinity - Infinity = NaN
select emult('fp64(3)[0:Infinity 1:1.0 2:2.0]'::vector,
    'fp64(3)[0:-1.0 1:2.0 2:3.0]'::vector,
    'plus_fp64'::binaryop);
