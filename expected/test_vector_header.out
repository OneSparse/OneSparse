(1 row)

-- Select with boolean mask
select choose('fp64(5)[0:1.5 1:2.5 2:1.0 3:3.5 4:2.0]'::vector,
    'valuege_fp64'::indexunaryop,
    2.0::double precision,
    mask=>'bool(5)[0:true 2:true 4:true]'::vector);
