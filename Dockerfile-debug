# get GraphBLAS, compile with debug symbols    
RUN curl -s -L -J https://github.com/DrTimothyAldenDavis/GraphBLAS/archive/refs/tags/v10.2.0.tar.gz | \
    tar zxvf - && cd GraphBLAS-10.2.0 && \
    make -j"${BUILD_JOBS:-$(nproc)}" debug \
#    CMAKE_OPTIONS='-DGRAPHBLAS_COMPACT=1 ' \
    && sudo make install \
    && /bin/rm -Rf GraphBLAS-10.2.0

RUN curl -s -L -J https://github.com/GraphBLAS/LAGraph/archive/refs/tags/v1.2.1.tar.gz | \
    tar zxvf - && cd LAGraph-1.2.1 && \
    make -j"${BUILD_JOBS:-$(nproc)}" library \
    && sudo make install \
    && /bin/rm -Rf LAGraph-1.2.1
    
RUN sudo ldconfig

# put test stuff into pg home        
RUN mkdir "/home/postgres/onesparse"
WORKDIR "/home/postgres/onesparse"
COPY . .
    
ENV EDITOR zile    

# make the extension
#RUN .virt/bin/python3 generate.py onesparse/onesparse--0.1.0.sql
RUN sudo make && sudo make install && sudo make clean

# start the database            
RUN initdb -D "$PGDATA" \
    -c shared_preload_libraries='onesparse' \
    -c search_path='public,onesparse' \
    -c onesparse.jit_control='on' \
    --encoding UTF8
EXPOSE 5432
# Keep the test container running until the harness starts PostgreSQL.
CMD sleep infinity
